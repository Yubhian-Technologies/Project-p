rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: src/services/firebase/storage.ts uploads to avatars/{uid}.
    // Any signed-in user can view avatars (they're shown on counsellor cards to
    // users browsing counsellors); only the owner can upload/replace their own.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false; // app only overwrites avatars, never deletes them
    }

    // Event completion reports: src/services/firebase/storage.ts uploads to
    // event-reports/{eventId}/report. Head, Admin, Super Admin, and Counsellor can
    // all view reports (mirrors the Firestore "events" read rule); Head or
    // Counsellor uploads/replaces (mirrors the Firestore "events" write rule).
    match /event-reports/{eventId}/{fileName} {
      allow read: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['head', 'admin', 'super-admin', 'counsellor'];
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['head', 'counsellor'] &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
