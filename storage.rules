rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: src/services/firebase/storage.ts uploads to avatars/{uid}.
    // Any signed-in user can view avatars (they're shown on counsellor cards to
    // users browsing counsellors); only the owner can upload/replace their own.
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false; // app only overwrites avatars, never deletes them
    }

    // Digital signature images: src/services/firebase/storage.ts uploads to
    // signatures/{uid}. Unlike avatars, this is private to the owner only —
    // Head/Counsellor/Admin accounts use this, and nobody else may read it.
    match /signatures/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if false; // app only overwrites, never deletes
    }

    // Event completion reports: src/services/firebase/storage.ts uploads to
    // event-reports/{eventId}/{uploaderUid}/report. Scoped by the uploader's
    // own uid — like avatars/{uid} above — rather than a firestore.get() role
    // lookup: that cross-service check proved unreliable (see monthly-reports
    // below, which hit the identical storage/unauthorized failure). The real
    // access control lives in the Firestore "events" rule (only Head/
    // Counsellor on the event's own campus can update it); any signed-in user
    // can read here (the download link is only ever reached through that
    // already-gated event data — students have no UI path to events at all).
    match /event-reports/{eventId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if false;
    }

    // Monthly reports: src/services/firebase/monthlyReports.ts uploads to
    // monthly-reports/{uploaderUid}/{year}/{month}/{fileName}. Scoped by the
    // uploader's own uid — like avatars/{uid} above — rather than a
    // firestore.get() role lookup: that cross-service check proved unreliable
    // here (uploads came back storage/unauthorized even for a genuine Head).
    // The real access control lives in the Firestore "monthlyReports" rule
    // (isRole('head') to create a listing, scoped reads for that head's own
    // college plus Admin/Super Admin) — a signed-in user can only
    // write/delete under their own uid segment here,
    // and any signed-in user can read (matches avatars' read rule; the
    // download link is only ever reached through the already-gated Firestore
    // listing). No contentType allowlist since Heads legitimately upload PDF,
    // Word, Excel, PowerPoint, CSV, and plain text reports.
    match /monthly-reports/{uid}/{year}/{month}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Signed/stamped copy of a consolidated report, produced by the
    // verifyMonthlyReport Cloud Function (functions/src/index.ts) once an
    // Admin with a signature on file verifies it. Written only by that
    // function via the Admin SDK, which bypasses these rules entirely — no
    // client ever writes here, hence allow write: if false.
    match /monthly-reports-signed/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Counsellor-submitted monthly reports: same pattern as monthly-reports
    // above (src/services/firebase/counsellorMonthlyReports.ts uploads to
    // counsellor-monthly-reports/{uploaderUid}/{year}/{month}/{fileName}).
    // The Firestore "counsellorMonthlyReports" rule scopes who can list/read
    // the resulting doc (the counsellor themself, or their own college's
    // Head) — this is immutable once submitted, so no delete here either.
    match /counsellor-monthly-reports/{uid}/{year}/{month}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 20 * 1024 * 1024;
      allow delete: if false;
    }

    // Session resources (music shared with a student during a session):
    // src/services/firebase/sessionResources.ts uploads to
    // session-resources/{uploaderUid}/{bookingId}/{resourceId}/track. Scoped by
    // the uploader's own uid — like avatars/{uid} above — rather than a
    // firestore.get() role lookup: that cross-service check proved unreliable
    // (see monthly-reports below). Access control lives in the Firestore
    // "session_resources" rule, which only lets the booking's own counsellor
    // create the resource doc; any signed-in user can read the audio here (the
    // download link is only ever reached through that already-gated Firestore
    // listing).
    match /session-resources/{uid}/{bookingId}/{resourceId}/track {
      allow read: if request.auth != null;
      // No contentType allowlist — exactly the storage/unauthorized failure
      // documented on monthly-reports below when a file's reported MIME is
      // null or unexpected (some browsers send application/octet-stream or an
      // empty type for perfectly valid audio files). Access control lives in
      // the Firestore "session_resources" rule, and the path is scoped to the
      // uploader's own uid, so only their size cap matters here.
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 15 * 1024 * 1024;
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
