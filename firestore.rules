rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return myProfile().role;
    }

    function isRole(role) {
      return isSignedIn() && myRole() == role;
    }

    // Head, Admin, Super Admin all have broad platform/campus oversight in this app today.
    function isStaff() {
      return isSignedIn() && myRole() in ['head', 'admin', 'super-admin'];
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function bookingOf(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    // True for super-admin and a "global"-scope admin (unrestricted, same
    // access every admin account had before per-admin scoping existed); for a
    // campus-restricted admin, true only when campusId is one of theirs.
    // Absence of adminAccess entirely = legacy/global admin, unchanged.
    function adminCanAccessCampus(campusId) {
      return isSignedIn() && (
        myRole() == 'super-admin' ||
        (myRole() == 'admin' && (
          !('adminAccess' in myProfile()) ||
          myProfile().adminAccess.scope == 'global' ||
          campusId in myProfile().adminAccess.campusIds
        ))
      );
    }

    // Only a "global"-scope admin (or super-admin) may create/edit/delete a
    // Campus or College record at all — a campus-restricted admin never can,
    // regardless of which campuses they're otherwise scoped to.
    function isGlobalCampusManager() {
      return isSignedIn() && (
        myRole() == 'super-admin' ||
        (myRole() == 'admin' && (!('adminAccess' in myProfile()) || myProfile().adminAccess.scope == 'global'))
      );
    }

    // Head and Counsellor can view any campus's Events & Programs calendar
    // (unchanged, pre-existing broad behavior); Admin/Super Admin only the
    // campus(es) they're scoped to.
    function canViewEventsCalendar(campusId) {
      return isRole('head') || isRole('counsellor') || adminCanAccessCampus(campusId);
    }

    // Head and Counsellor jointly manage a campus's Events & Programs calendar —
    // either can create/edit/delete any year/month/event on their own campus, not
    // just ones they personally created.
    function canEditEventsCalendar() {
      return isSignedIn() && myRole() in ['head', 'counsellor'];
    }

    // Head and Counsellor jointly manage a campus's Counsellor Worksheet —
    // either can create/edit/delete any academic year, worksheet, or row
    // on their own campus.
    function canEditWorksheets() {
      return isSignedIn() && myRole() in ['head', 'counsellor'];
    }

    // Head and Counsellor can resolve who authored anonymous community posts —
    // moderation-only visibility, and ONLY for posts on their own campus.
    // Regular users (and other roles) never see it.
    function canSeeCommunityAuthor(postId) {
      return isSignedIn() && myRole() in ['head', 'counsellor']
        && get(/databases/$(database)/documents/communityPosts/$(postId)).data.campusId == myProfile().campusId;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Public Signup always creates role "user" for exactly the signed-up account.
      // Counsellor/Head/Admin/Super-Admin accounts are created ONLY by the
      // createCampusLogin Cloud Function (Admin SDK, bypasses these rules).
      allow create: if isSelf(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'user';

      allow update: if isSignedIn() && (
        (
          // Self-service profile edits: never touch role/campus/college/email.
          isSelf(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.campusId == resource.data.campusId &&
          request.resource.data.collegeId == resource.data.collegeId &&
          request.resource.data.email == resource.data.email
        ) || (
          // Head/Admin/Super Admin toggling a counsellor's/head's availability badge.
          isStaff() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available'])
        ) || (
          // Super Admin fixing a student ("user" role) account's campus/college and
          // basic details — e.g. accounts created before Campus/College existed,
          // which have no other admin UI path to reach them. Role/email/uid can
          // never change here, and only "user" role accounts are touched — staff
          // accounts stay exclusively managed via the createCampusLogin/
          // updateCampusLogin Cloud Functions.
          isRole('super-admin') &&
          resource.data.role == 'user' &&
          request.resource.data.role == 'user' &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['campusId', 'collegeId', 'displayName', 'studentOrProfessional', 'whatsappNumber', 'registerNumber', 'yearOrBatch', 'admissionType', 'branch', 'gender', 'bioData'])
        )
      );

      // No client-side deletes. deleteCampusLogin Cloud Function (Admin SDK) handles this.
      allow delete: if false;

      // Private index of a user's own anonymous community posts/comments —
      // lets their own client show a "Delete" button on their own anonymous
      // content without ever exposing authorship to anyone else.
      match /myCommunityPosts/{postId} {
        allow read, write: if isSelf(uid);
      }
      match /myCommunityComments/{commentId} {
        allow read, write: if isSelf(uid);
      }

      // A Head/Counsellor/Admin's digital signature image — private to the
      // owner only, unlike the shared profile fields above which any
      // signed-in user can read.
      match /signature/{docId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---------- campuses ----------
    match /campuses/{campusId} {
      // Public Signup page reads this list before the visitor has an account.
      allow read: if true;
      // A campus-restricted admin can never create/edit/delete a campus —
      // only a global admin or super-admin can.
      allow write: if isGlobalCampusManager();
    }

    // ---------- colleges ----------
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if isGlobalCampusManager();
    }

    // ---------- events ----------
    match /events/{eventId} {
      // Head, Admin, Super Admin, and Counsellor can all view events/programs
      // (this is what powers Admin's Group Sessions analytics) with no campus
      // check. Students get a narrower branch: their own campus only — this
      // is the ONLY access a student has to this collection, so it's enforced
      // here rather than trusted to the client query alone. campusId is also
      // the exact field listEventsForCampus() queries on, so Firestore can
      // validate that list query against this check.
      allow read: if canViewEventsCalendar(resource.data.campusId) || (isRole('user') && resource.data.campusId == myProfile().campusId);

      // Head or Counsellor can create an event, only for their own campus + a
      // college that actually belongs to that campus.
      allow create: if canEditEventsCalendar()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId
                    && get(/databases/$(database)/documents/colleges/$(request.resource.data.collegeId)).data.campusId == myProfile().campusId;

      // Any Head/Counsellor on the same campus can update the event (not just its
      // creator), but updates may never move it to a different campus/college/year
      // container or reassign who created it.
      allow update: if canEditEventsCalendar()
                    && resource.data.campusId == myProfile().campusId
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.collegeId == resource.data.collegeId
                    && request.resource.data.calendarYearId == resource.data.calendarYearId
                    && request.resource.data.calendarMonthId == resource.data.calendarMonthId
                    && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if canEditEventsCalendar() && resource.data.campusId == myProfile().campusId;
    }

    // ---------- calendarYears ----------
    match /calendarYears/{yearId} {
      // Head, Admin, Super Admin, and Counsellor can all view the academic years
      // written for a college; Head or Counsellor on that campus can create one.
      allow read: if canViewEventsCalendar(resource.data.campusId);
      allow create: if canEditEventsCalendar()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId
                    && get(/databases/$(database)/documents/colleges/$(request.resource.data.collegeId)).data.campusId == myProfile().campusId;

      // Any Head/Counsellor on the same campus can rename or delete a year, but
      // never reassign it to a different campus/college/owner.
      allow update: if canEditEventsCalendar()
                    && resource.data.campusId == myProfile().campusId
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.collegeId == resource.data.collegeId
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canEditEventsCalendar() && resource.data.campusId == myProfile().campusId;
    }

    // ---------- calendarMonths ----------
    match /calendarMonths/{monthId} {
      // Same shape as calendarYears — Head or Counsellor adds months one at a time.
      allow read: if canViewEventsCalendar(resource.data.campusId);
      allow create: if canEditEventsCalendar()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId
                    && get(/databases/$(database)/documents/colleges/$(request.resource.data.collegeId)).data.campusId == myProfile().campusId;

      // Any Head/Counsellor on the same campus can change which month/year this row
      // represents or delete it, but never move it to a different year
      // container/campus/college/owner.
      allow update: if canEditEventsCalendar()
                    && resource.data.campusId == myProfile().campusId
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.collegeId == resource.data.collegeId
                    && request.resource.data.yearId == resource.data.yearId
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canEditEventsCalendar() && resource.data.campusId == myProfile().campusId;
    }

    // ---------- worksheetAcademicYears ----------
    // Campus-wide (not college-scoped) — a Head or Counsellor manages the
    // L&D/training schedule for every college in their campus.
    match /worksheetAcademicYears/{yearId} {
      allow read: if isSignedIn() && (resource.data.campusId == myProfile().campusId || adminCanAccessCampus(resource.data.campusId));
      allow create: if canEditWorksheets()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId;
      allow update: if canEditWorksheets()
                    && resource.data.campusId == myProfile().campusId
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canEditWorksheets() && resource.data.campusId == myProfile().campusId;
    }

    // ---------- worksheets ----------
    match /worksheets/{worksheetId} {
      allow read: if isSignedIn() && (resource.data.campusId == myProfile().campusId || adminCanAccessCampus(resource.data.campusId));
      allow create: if canEditWorksheets()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId;
      allow update: if canEditWorksheets()
                    && resource.data.campusId == myProfile().campusId
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.academicYearId == resource.data.academicYearId
                    && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canEditWorksheets() && resource.data.campusId == myProfile().campusId;

      // ---------- worksheets/{worksheetId}/rows ----------
      // Head and Counsellor both have full edit rights on any row in
      // their campus — either can add, edit, delete, or flip the status
      // of any session row.
      match /rows/{rowId} {
        allow read: if isSignedIn() && (resource.data.campusId == myProfile().campusId || adminCanAccessCampus(resource.data.campusId));

        allow create: if canEditWorksheets() && request.resource.data.campusId == myProfile().campusId;

        allow update: if canEditWorksheets() && resource.data.campusId == myProfile().campusId;

        allow delete: if canEditWorksheets() && resource.data.campusId == myProfile().campusId;
      }
    }

    // ---------- attendance ----------
    // Daily check-in / check-out. Exactly one record per user per day
    // (doc id = {uid}_{YYYY-MM-DD}): check-in creates it, check-out
    // fills in checkOutAt. Counsellors and Heads record their own
    // attendance on their own campus; a Head reviews their campus's
    // counsellors; Admins/Super Admins see every campus.
    match /attendance/{recordId} {
      // The owner check is derived from the doc id ({uid}_{date}), not from
      // resource.data — reading a field on a record that doesn't exist yet
      // (e.g. before today's first check-in) fails the whole rule, since
      // `resource` is null. A path-based check works whether or not the
      // record exists yet.
      allow read: if isSignedIn() && (
        recordId.split('_')[0] == request.auth.uid ||
        (isStaff() && resource.data.campusId == myProfile().campusId) ||
        adminCanAccessCampus(resource.data.campusId)
      );

      // Check-in: the owner only, counsellor or head only, on their own campus,
      // for the day named in the doc id, and stamped within ten minutes of the
      // server's clock so times can't be backdated. Only check-in fields may be set.
      // (Reading a field that doesn't exist fails the whole rule, so the
      // "not yet checked out" test uses `in` instead of comparing to null.)
      allow create: if isSignedIn()
                    && myRole() in ['counsellor', 'head']
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId
                    && recordId == request.auth.uid + '_' + request.resource.data.date
                    && request.resource.data.checkInAt is number
                    && request.resource.data.checkInAt <= request.time.toMillis() + 600000
                    && request.resource.data.checkInAt >= request.time.toMillis() - 600000
                    && !('checkOutAt' in request.resource.data)
                    && request.resource.data.keys().hasOnly(['uid', 'campusId', 'date', 'checkInAt', 'updatedAt']);

      // Check-out: fills checkOutAt exactly once. Nothing else on the record
      // can change, so the check-in time and day can't be rewritten.
      allow update: if isSignedIn()
                    && myRole() in ['counsellor', 'head']
                    && resource.data.uid == request.auth.uid
                    && 'checkInAt' in resource.data
                    && !('checkOutAt' in resource.data)
                    && request.resource.data.checkOutAt is number
                    && request.resource.data.checkOutAt <= request.time.toMillis() + 600000
                    && request.resource.data.checkOutAt >= request.time.toMillis() - 600000
                    && request.resource.data.checkOutAt > resource.data.checkInAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOutAt', 'updatedAt']);

      allow delete: if false;
    }

    // ---------- workloadSheets/{ownerUid}/rows ----------
    // Each person's workload rows (compulsory / optional / action items).
    // The owner can read and edit their own rows; the same-campus Head can
    // read and edit any row on the campus; admin / super-admin can read all
    // rows for analytics. Nothing crosses campuses.
    match /workloadSheets/{ownerUid}/rows/{rowId} {
      allow read: if isSignedIn() && (
        ownerUid == request.auth.uid ||
        (isRole('head') && resource.data.campusId == myProfile().campusId) ||
        adminCanAccessCampus(resource.data.campusId)
      );
      allow create: if canEditWorksheets()
                    && (ownerUid == request.auth.uid || isRole('head'))
                    && request.resource.data.ownerUid == ownerUid
                    && request.resource.data.campusId == myProfile().campusId;
      allow update: if canEditWorksheets()
                    && (resource.data.ownerUid == request.auth.uid || isRole('head'))
                    && resource.data.campusId == myProfile().campusId
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if canEditWorksheets()
                    && (resource.data.ownerUid == request.auth.uid || isRole('head'))
                    && resource.data.campusId == myProfile().campusId;
    }

    // ---------- bookings ----------
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.counsellorId == request.auth.uid ||
        isRole('head') || adminCanAccessCampus(resource.data.campusId) ||
        // listScheduledBookings() is queried platform-wide by every signed-in user
        // (BookingSection.tsx) purely to compute a counsellor's live "in session"
        // badge. Only "scheduled" bookings are exposed this way; the sensitive
        // intake subcollection below stays locked to the two parties + staff.
        resource.data.status == 'scheduled' ||
        // A Counsellor can see every emergency SOS booking on their own campus
        // (the Emergency Alerts section), not just ones formally assigned to them.
        (resource.data.isEmergency == true && isRole('counsellor') && resource.data.campusId == myProfile().campusId)
      );

      // A normal session request is no longer written directly by the client —
      // it goes through the createBooking Cloud Function (Admin SDK, bypasses
      // these rules), which is what actually enforces "one active booking per
      // student" server-side instead of just hiding a disabled button. Emergency
      // SOS bookings are deliberately excluded from that — createEmergencySosBooking
      // still writes userId == self directly, unchanged, since a crisis flow should
      // never be gated behind anything extra. Offline-session import (a counsellor
      // logging a historical in-person session) is unrelated and also unchanged.
      allow create: if isSignedIn() && (
        (request.resource.data.userId == request.auth.uid && request.resource.data.isEmergency == true) ||
        request.resource.data.counsellorId == request.auth.uid
      );

      // Covers accept/reject/schedule/cancel/close/transfer — all performed by
      // the user, the assigned counsellor, or Head/Admin/Super Admin oversight
      // actions. Writes that touch either side's rating fields are excluded
      // here (see the one-time rating rules below) so a rating can never be
      // silently overwritten through the general party/staff branch.
      allow update: if isSignedIn() && (
        (
          resource.data.userId == request.auth.uid ||
          resource.data.counsellorId == request.auth.uid ||
          isStaff() ||
          (
            // Any Counsellor on the same campus can claim (accept) a still-pending
            // emergency SOS, not just whoever it was auto-assigned to — speed
            // matters more than the original best-guess pick in a crisis. (Head is
            // already covered by isStaff() above.)
            isRole('counsellor') &&
            resource.data.isEmergency == true &&
            resource.data.status == 'pending' &&
            resource.data.campusId == myProfile().campusId &&
            request.resource.data.counsellorId == request.auth.uid &&
            request.resource.data.counsellorEmail == myProfile().email &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.campusId == resource.data.campusId &&
            request.resource.data.isEmergency == true
          )
        ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userRatingOfCounsellor', 'userReviewText', 'ratedAt',
          'counsellorRatingOfUser', 'counsellorNoteOnUser', 'counsellorRatedAt',
          'sharedSummary', 'sharedSummaryAt'
        ])
      ) || (
        // One-time user rating of a held session. The user may rate only their
        // own completed, non-missed booking — and only once (the booking must
        // carry no rating yet) — and only ever write the rating/review/timestamp
        // keys. This is what ties each feedback form submission to the exact
        // counsellor who took the session (booking.counsellorId) and powers the
        // Admin Counsellor Ratings dashboard.
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'completed' &&
        resource.data.outcome != 'missed' &&
        !('userRatingOfCounsellor' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'userRatingOfCounsellor', 'userReviewText', 'ratedAt', 'updatedAt'
        ])
      ) || (
        // Symmetric one-time counsellor rating of the user (rateUser()) — same
        // shape as the user-rating branch above. Previously this had NO
        // one-time protection at all and fell through the general party
        // branch, letting a counsellor silently overwrite a prior rating/note
        // with no audit trail.
        isSignedIn() &&
        resource.data.counsellorId == request.auth.uid &&
        resource.data.status == 'completed' &&
        resource.data.outcome != 'missed' &&
        !('counsellorRatingOfUser' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'counsellorRatingOfUser', 'counsellorNoteOnUser', 'counsellorRatedAt', 'updatedAt'
        ])
      ) || (
        // The assigned counsellor or staff (never the student) sharing the
        // session summary — the one and only way sharedSummary/sharedSummaryAt
        // can be written, so a student can never fake or alter it themselves.
        isSignedIn() &&
        (resource.data.counsellorId == request.auth.uid || isStaff()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sharedSummary', 'sharedSummaryAt', 'updatedAt'
        ])
      );

      allow delete: if false;

      // Sensitive intake details: name, occupation, WhatsApp number, issue, session summary.
      match /private/details {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.counsellorId == request.auth.uid ||
          isStaff() ||
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.isEmergency == true &&
            isRole('counsellor') &&
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.campusId == myProfile().campusId
          )
        );
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.counsellorId == request.auth.uid
        );
      }
    }

    // ---------- sessionFeedback ----------
    // One doc per held session (the doc id IS the booking id, so a session can
    // receive at most one feedback — a second submission is a create conflict).
    // Written directly by the app from the signed-in student's own account via
    // the in-app feedback form (no external bridge).
    //
    // Reading is role-scoped: the student who gave the feedback, the counsellor
    // who took the session (who should see the full details), and staff
    // (Head/Admin/Super Admin — overall ratings and details) can all read it.
    match /sessionFeedback/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.counsellorId == request.auth.uid ||
        isRole('head') || adminCanAccessCampus(resource.data.campusId)
      );

      // The sender must be the student of the matching booking; the booking
      // must exist, be completed and not missed, and must belong to the
      // counsellor the feedback names. Doc id === bookingId enforces one
      // response per session.
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.bookingId == bookingId
                    && request.resource.data.keys().hasOnly([
                      'bookingId', 'userId', 'userEmail', 'counsellorId', 'counsellorEmail',
                      'campusId', 'rating', 'answers', 'submittedAt'
                    ])
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'completed'
                    && get(/databases/$(database)/documents/bookings/$(bookingId)).data.outcome != 'missed'
                    && get(/databases/$(database)/documents/bookings/$(bookingId)).data.userId == request.resource.data.userId
                    && get(/databases/$(database)/documents/bookings/$(bookingId)).data.counsellorId == request.resource.data.counsellorId;

      allow update: if false;
      allow delete: if false;
    }

    // ---------- ssi_results ----------
    // One SSI (pre-session assessment) test per booking — the doc id IS the
    // booking id, so a second submission is a create conflict (single attempt).
    // The student takes it after the counsellor accepts the session and before
    // it starts. Reading is scoped to the student, their assigned counsellor,
    // and staff. counsellorId is live-reassigned via the booking, so whoever
    // holds the session can view the result.
    match /ssi_results/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.counsellorId == request.auth.uid ||
        isRole('head') || adminCanAccessCampus(bookingOf(bookingId).campusId)
      );

      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.bookingId == bookingId
                    && request.resource.data.keys().hasOnly([
                      'bookingId', 'userId', 'userEmail', 'counsellorId', 'counsellorEmail',
                      'level1', 'likertAnswers', 'level3Answers', 'likertScore', 'likertMax',
                      'depressionScore', 'anxietyScore', 'stressScore',
                      'whatsappNumber', 'consentGiven', 'consentItems', 'submittedAt'
                    ])
                    && request.resource.data.likertScore is number
                    && request.resource.data.likertScore >= 0
                    && request.resource.data.depressionScore is number
                    && request.resource.data.anxietyScore is number
                    && request.resource.data.stressScore is number
                    && request.resource.data.consentGiven == true
                    && bookingOf(bookingId).userId == request.resource.data.userId
                    && bookingOf(bookingId).counsellorId == request.resource.data.counsellorId
                    && bookingOf(bookingId).status in ['accepted', 'scheduled'];

      allow update: if false;
      allow delete: if false;
    }

    // ---------- ssi_college_results ----------
    // The standalone SSI check-in (no booking involved) — a student can take
    // it anytime, as often as they like, so doc ids are auto-generated rather
    // than keyed off a booking. A Counsellor only reads their own college's
    // submissions (isolated by collegeId — not other colleges, even in the
    // same campus); a Head oversees every college in their campus, same as
    // everywhere else in this file, so they're scoped by campusId instead.
    // Bug fix: this used to require myProfile().collegeId == resource.data.collegeId
    // for BOTH roles, meaning a Head's own single collegeId had to coincidentally
    // match — querying any OTHER college in their own campus (as
    // HeadCommandCentre.tsx's home dashboard does, across every college) was
    // rejected outright with permission-denied.
    match /ssi_college_results/{resultId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (isRole('counsellor') && myProfile().collegeId == resource.data.collegeId) ||
        (isRole('head') && myProfile().campusId == resource.data.campusId)
      );

      allow create: if isSignedIn()
                    && myRole() == 'user'
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.collegeId == myProfile().collegeId
                    && request.resource.data.keys().hasOnly([
                      'userId', 'userEmail', 'displayName', 'collegeId', 'campusId',
                      'level1', 'likertAnswers', 'level3Answers', 'likertScore', 'likertMax',
                      'depressionScore', 'anxietyScore', 'stressScore', 'severity',
                      'whatsappNumber', 'consentGiven', 'consentItems', 'submittedAt'
                    ])
                    && request.resource.data.severity in ['normal', 'medium', 'severe']
                    && request.resource.data.likertScore is number
                    && request.resource.data.likertScore >= 0
                    && request.resource.data.depressionScore is number
                    && request.resource.data.anxietyScore is number
                    && request.resource.data.stressScore is number
                    && request.resource.data.consentGiven == true;

      allow update: if false;
      allow delete: if false;
    }

    // One private chat room per booking — each message stores chatRoomId = the
    // booking id. Access is limited to the two parties: the student (userId)
    // and the counsellor currently assigned to the booking. counsellorId is
    // live-reassigned on transfer, follow-up, and emergency claim, so whoever
    // actually owns the request can chat. Staff (Head/Admin/Super Admin) may
    // read for oversight but never write into a private conversation.
    match /chat_messages/{messageId} {
      allow read: if isSignedIn() && (
        isRole('head') || adminCanAccessCampus(bookingOf(resource.data.chatRoomId).campusId) ||
        bookingOf(resource.data.chatRoomId).userId == request.auth.uid ||
        bookingOf(resource.data.chatRoomId).counsellorId == request.auth.uid
      );

      allow create: if isSignedIn()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'chatRoomId', 'bookingId', 'senderUid', 'senderEmail',
                      'senderName', 'senderRole', 'text', 'createdAt'
                    ])
                    && (
                      isStaff() ||
                      bookingOf(request.resource.data.chatRoomId).userId == request.auth.uid ||
                      bookingOf(request.resource.data.chatRoomId).counsellorId == request.auth.uid
                    );

      allow update: if false;
      allow delete: if false;
    }

    // ---------- teamChatMessages ----------
    // One shared chat room per campus for that campus's Head + every
    // counsellor to coordinate in — not tied to any booking. Only
    // Head/Counsellor accounts of the matching campus can read or post;
    // students and staff of other campuses never see it.
    match /teamChatMessages/{messageId} {
      allow read: if isSignedIn()
                  && myRole() in ['counsellor', 'head']
                  && resource.data.campusId == myProfile().campusId;

      allow create: if isSignedIn()
                    && myRole() in ['counsellor', 'head']
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId
                    && request.resource.data.keys().hasOnly([
                      'campusId', 'senderUid', 'senderEmail', 'senderName', 'senderRole', 'text', 'createdAt'
                    ]);

      allow update: if false;
      allow delete: if false;
    }

    // ---------- notifications ----------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;

      // The creator must be a party to the referenced booking, and the recipient
      // must be the other party on that same booking — blocks notification spam.
      // If this ever proves too strict (createNotification already fails silently
      // into a console.error on rejection), the simple fallback is:
      //   allow create: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.read == false &&
        (
          (
            request.resource.data.keys().hasAll(['bookingId']) &&
            (
              get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid ||
              get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.counsellorId == request.auth.uid
            ) &&
            (
              get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.resource.data.recipientId ||
              get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.counsellorId == request.resource.data.recipientId
            )
          ) || (
            // Crisis SOS broadcast: the dispatching student notifies EVERY
            // Head/Counsellor on their own campus, not just the one formally
            // assigned to the booking.
            request.resource.data.keys().hasAll(['bookingId']) &&
            request.resource.data.type == 'emergency_sos' &&
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid &&
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.isEmergency == true &&
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.campusId == myProfile().campusId &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role in ['head', 'counsellor']
          ) || (
            // A Counsellor requesting their own campus Head's approval to
            // transfer a booking — the Head isn't a party to the booking.
            request.resource.data.keys().hasAll(['bookingId']) &&
            request.resource.data.type == 'transfer_requested' &&
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.counsellorId == request.auth.uid &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'head' &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          ) || (
            // A Counsellor telling their own campus Head that a session of
            // theirs was missed, or is overdue and not yet marked — same
            // shape as transfer_requested above; the Head isn't a party to
            // the booking either.
            request.resource.data.keys().hasAll(['bookingId']) &&
            request.resource.data.type in ['booking_missed', 'session_needs_review'] &&
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.counsellorId == request.auth.uid &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'head' &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          ) || (
            // A student telling their campus Head whether they accept or
            // decline a compensation-session offer for a missed booking —
            // same shape as booking_missed above; the Head isn't a party to
            // the booking either.
            request.resource.data.keys().hasAll(['bookingId']) &&
            request.resource.data.type in ['compensation_accepted', 'compensation_declined'] &&
            get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.auth.uid &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'head' &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          ) || (
            // Staff (a Head, approving/declining a transfer request, etc.) acting
            // administratively on a booking can notify either party even though
            // the staff member isn't a party to the booking themselves.
            request.resource.data.keys().hasAll(['bookingId']) &&
            isStaff() &&
            (
              get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.userId == request.resource.data.recipientId ||
              get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.counsellorId == request.resource.data.recipientId
            )
          ) || (
            // Platform-level alerts with NO booking link: Head/Counsellor/Admin
            // events and monthly reports kept Admins informed across campuses.
            request.resource.data.type in ['event_added', 'monthly_report_uploaded'] &&
            isSignedIn() && myRole() in ['head', 'counsellor', 'admin', 'super-admin'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'admin'
          ) || (
            // Immediate "event today" alert when a Head/Counsellor creates an
            // event already dated for today — every student, counsellor, and
            // head on that same campus. No booking link involved.
            request.resource.data.type == 'event_today' &&
            isSignedIn() && myRole() in ['head', 'counsellor'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role in ['user', 'counsellor', 'head'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          ) || (
            // A student sharing a journal entry with a same-campus counsellor
            // or Head — also has no booking link, and the recipient here isn't
            // necessarily an Admin, so this needs its own branch rather than
            // reusing the platform-alert one above.
            request.resource.data.type == 'journal_entry_shared' &&
            isSignedIn() && myRole() == 'user' &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role in ['counsellor', 'head'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          ) || (
            // A Counsellor telling their own campus's Head they've submitted a
            // monthly report — same event type as the platform-alert branch
            // above, but the recipient here is the Head, not Admin.
            request.resource.data.type == 'monthly_report_uploaded' &&
            isSignedIn() && myRole() == 'counsellor' &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role == 'head' &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          ) || (
            // Whoever claims a Crisis SOS tells every other same-campus
            // Head/Counsellor it's already being handled — no booking link
            // needed since the recipients here aren't parties to it.
            request.resource.data.type == 'emergency_sos_claimed' &&
            isSignedIn() && myRole() in ['head', 'counsellor'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role in ['head', 'counsellor'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          ) || (
            // Team chat: every message pings every other same-campus
            // Head/Counsellor — no booking link involved.
            request.resource.data.type == 'team_chat_message' &&
            isSignedIn() && myRole() in ['head', 'counsellor'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.role in ['head', 'counsellor'] &&
            get(/databases/$(database)/documents/users/$(request.resource.data.recipientId)).data.campusId == myProfile().campusId
          )
        );

      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    // ---------- journalEntries ----------
    // Fully private diary — unlike bookings, staff have ZERO visibility here.
    // One doc per calendar day; the doc id IS the "YYYY-MM-DD" date, which
    // doubles as the reminder trigger date when isReminder is set. Ownership
    // is structural (uid is a path segment) so no field-level check is needed.
    match /journalEntries/{uid}/entries/{dateId} {
      allow read, write: if isSelf(uid);
    }

    // ---------- sharedJournalEntries ----------
    // A student's deliberate, one-off share of ONE entry with ONE same-campus
    // counsellor or Head they pick — completely separate from journalEntries
    // above, which this never reads from or grants any broader access to. No
    // blanket staff bypass here on purpose: Head only sees an entry if a
    // student specifically chose to share it with them, same as a counsellor.
    match /sharedJournalEntries/{shareId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.counsellorId == request.auth.uid
      );

      allow create: if isSignedIn()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                      'studentId', 'studentEmail', 'counsellorId', 'date', 'note', 'sharedAt'
                    ])
                    && request.resource.data.note is string
                    && request.resource.data.note.size() > 0
                    && request.resource.data.note.size() <= 10000
                    && request.resource.data.date is string
                    && request.resource.data.sharedAt is number
                    && get(/databases/$(database)/documents/users/$(request.resource.data.counsellorId)).data.role in ['counsellor', 'head']
                    && get(/databases/$(database)/documents/users/$(request.resource.data.counsellorId)).data.campusId == myProfile().campusId;

      allow update: if false;
      // Only the student can revoke their own share; the counsellor it was
      // shared with cannot delete it out from under the student.
      allow delete: if isSignedIn() && resource.data.studentId == request.auth.uid;
    }

    // ---------- moodLogs ----------
    match /moodLogs/{uid}/entries/{dateId} {
      allow read, write: if isSelf(uid);
    }

    // ---------- communityPosts ----------
    // Anonymous, CAMPUS-SCOPED social feed — each campus sees only its own
    // posts, and moderation identity is only revealed to that campus's own
    // Head/Counsellor. CRITICAL: other regular users — not even calls bypassing
    // the app's UI — may ever learn who authored a post/comment/like, while the
    // author must still be able to delete their own anonymous content.
    //
    // Firestore rules cannot hide a single field on an otherwise-readable
    // document, so authorId is NOT a field on the public post/comment docs.
    // It lives on a nested private/author doc (same shape as
    // bookings/{id}/private/details) whose own read rule only ever succeeds
    // for the author themselves and for the Head/Counsellor moderation view of
    // the author's own campus (canSeeCommunityAuthor(postId)). The public doc's
    // delete rule uses get() against that private doc, so the owner can delete
    // without authorId ever appearing on any doc you can read.
    //
    // Likes are communityPosts/{postId}/likes/{uid}: the liker's own uid IS
    // the doc id, so "one like per user" and "only I can touch my own like"
    // fall out of isSelf(likeId) with no extra field. list is denied so
    // nobody can enumerate who liked a post. Liking is also campus-gated.
    match /communityPosts/{postId} {
      allow read: if isSignedIn()
                  && resource.data.campusId == myProfile().campusId;

      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['text', 'likeCount', 'commentCount', 'createdAt', 'campusId'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    && request.resource.data.likeCount == 0
                    && request.resource.data.commentCount == 0
                    && request.resource.data.campusId == myProfile().campusId;

      // Only the like-toggle and comment-count transactions touch this doc
      // after creation, each moving exactly one counter by exactly 1.
      allow update: if isSignedIn()
                    && resource.data.campusId == myProfile().campusId && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) &&
          (request.resource.data.likeCount == resource.data.likeCount + 1 ||
           request.resource.data.likeCount == resource.data.likeCount - 1)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) &&
          (request.resource.data.commentCount == resource.data.commentCount + 1 ||
           request.resource.data.commentCount == resource.data.commentCount - 1))
      );

      // A Head can delete any post on their own campus (moderation), no matter
      // who wrote it — same campus scoping as canSeeCommunityAuthor above, but
      // deletion is intentionally Head-only, not Counsellor.
      allow delete: if isSignedIn()
                    && resource.data.campusId == myProfile().campusId
                    && (
                      get(/databases/$(database)/documents/communityPosts/$(postId)/private/author).data.authorId == request.auth.uid ||
                      isRole('head')
                    );

      match /private/author {
        allow get: if isSelf(resource.data.authorId) || canSeeCommunityAuthor(postId);
        allow list: if false;
        allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['authorId']);
        allow update: if false;
        // A Head moderating a post also needs to delete this doc alongside it —
        // deleteCommunityPost() removes both. No campus check here (unlike the
        // post-level rule above): by the time this subdoc delete runs, the
        // parent post may already be gone, so there's nothing left to check it
        // against; the only data at stake is an internal authorship pointer,
        // never shown to anyone.
        allow delete: if isSelf(resource.data.authorId) || isRole('head');
      }

      match /comments/{commentId} {
        allow read: if isSignedIn()
                    && get(/databases/$(database)/documents/communityPosts/$(postId)).data.campusId == myProfile().campusId;
        allow create: if isSignedIn()
                      && get(/databases/$(database)/documents/communityPosts/$(postId)).data.campusId == myProfile().campusId
                      && request.resource.data.keys().hasOnly(['postId', 'text', 'createdAt'])
                      && request.resource.data.postId == postId
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if isSignedIn()
                      && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)/private/author).data.authorId == request.auth.uid;

        match /private/author {
          allow get: if isSelf(resource.data.authorId) || canSeeCommunityAuthor(postId);
          allow list: if false;
          allow create: if isSignedIn()
                        && request.resource.data.authorId == request.auth.uid
                        && request.resource.data.keys().hasOnly(['authorId']);
          allow update: if false;
          allow delete: if isSelf(resource.data.authorId);
        }
      }

      match /likes/{likeId} {
        allow get: if isSelf(likeId);
        allow list: if false;
        allow create: if isSelf(likeId)
                      && get(/databases/$(database)/documents/communityPosts/$(postId)).data.campusId == myProfile().campusId;
        allow delete: if isSelf(likeId);
        allow update: if false;
      }
    }

    // ---------- monthlyReports ----------
    // A campus's consolidated report — there is exactly one Head per campus,
    // overseeing every college in it, who compiles this from that campus's
    // counsellor submissions and sends it up to Admin. Admin/Super Admin
    // browse platform-wide (their tab has its own campus picker) and are the
    // only ones who can verify it; the Head may only read/create/delete their
    // own campus's reports — never another campus's. Counsellors have no
    // access here at all (their own reports live in counsellorMonthlyReports).
    match /monthlyReports/{reportId} {
      allow read: if adminCanAccessCampus(resource.data.campusId)
                  || (isRole('head') && resource.data.campusId == myProfile().campusId);
      allow create: if isRole('head')
                    && request.resource.data.uploadedByUid == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId
                    && request.resource.data.collegeId == myProfile().collegeId
                    && request.resource.data.status == 'pending';
      // Only Admin/Super Admin can verify (update status → verified); the
      // report's identity/ownership fields must stay untouched.
      allow update: if adminCanAccessCampus(resource.data.campusId)
                    && request.resource.data.status == 'verified'
                    && request.resource.data.uploadedByUid == resource.data.uploadedByUid
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if isRole('head')
                    && resource.data.uploadedByUid == request.auth.uid
                    && resource.data.campusId == myProfile().campusId;
    }

    // ---------- counsellorMonthlyReports ----------
    // A counsellor's own monthly report, submitted straight to (and visible
    // only to) their campus's one Head — who oversees every college in that
    // campus, not just the counsellor's own college — never to Admin, and
    // never to another campus's Head. Immutable except for the Head's own
    // verification of it: no delete by anyone, and no update besides that
    // Head marking it verified.
    match /counsellorMonthlyReports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.uploadedByUid == request.auth.uid ||
        (isRole('head') && resource.data.campusId == myProfile().campusId)
      );
      allow create: if isRole('counsellor')
                    && request.resource.data.uploadedByUid == request.auth.uid
                    && request.resource.data.campusId == myProfile().campusId
                    && request.resource.data.collegeId == myProfile().collegeId
                    && request.resource.data.status == 'pending';
      // Only that campus's Head can verify it; the report's identity/
      // ownership fields must stay untouched.
      allow update: if isRole('head')
                    && resource.data.campusId == myProfile().campusId
                    && request.resource.data.status == 'verified'
                    && request.resource.data.uploadedByUid == resource.data.uploadedByUid
                    && request.resource.data.campusId == resource.data.campusId
                    && request.resource.data.collegeId == resource.data.collegeId;
      allow delete: if false;
    }

    // ---------- flash_qa ----------
    // A student reads only their own campus's daily flash cards. Any Head,
    // Admin, or Super Admin can preview every campus's cards from their
    // management dashboards. A Head publishes only to their own campus
    // (mirrors the events calendar's campus enforcement); Admin/Super Admin
    // can manage any campus's cards.
    match /flash_qa/{qaId} {
      allow read: if isSignedIn() && (
        resource.data.campusId == myProfile().campusId ||
        isRole('head') || adminCanAccessCampus(resource.data.campusId)
      );

      allow write: if isSignedIn() && (
        (isRole('head') && request.resource.data.campusId == myProfile().campusId) ||
        adminCanAccessCampus(request.resource.data.campusId)
      );
    }

    // ---------- session_resources ----------
    // Music files and links a counsellor (or a head holding their own session)
    // shares with a student for the duration of a booking — like chat_messages,
    // access is scoped to the two parties of the booking (student + the
    // counsellor assigned to it) plus staff read-for-oversight. The reference
    // to the booking's counsellor is taken live from the booking doc, so access
    // follows transfers and emergency claims automatically.
    match /session_resources/{resourceId} {
      // Checked via bookingOf(resource.data.bookingId) rather than the resource's
      // own userId/counsellorId fields — the app queries this collection with
      // where("bookingId", "==", ...), and Firestore can only allow a list query
      // when the rule is provably true using fields the query itself filters on.
      // Because bookingId IS that filter, referencing it (even inside a get())
      // is fine; checking userId/counsellorId directly on the resource document
      // is not, and silently denied the whole query for the student and the
      // counsellor (only isStaff() — a query-independent constant — got through).
      allow read: if isSignedIn() && (
        bookingOf(resource.data.bookingId).userId == request.auth.uid ||
        bookingOf(resource.data.bookingId).counsellorId == request.auth.uid ||
        isRole('head') || adminCanAccessCampus(bookingOf(resource.data.bookingId).campusId)
      );

      // Only the counsellor currently holding the booking can add resources —
      // the student reads, and Heads add only to sessions they personally hold.
      allow create: if isSignedIn()
                    && request.resource.data.bookingId is string
                    && request.resource.data.userId is string
                    && request.resource.data.counsellorId is string
                    && request.resource.data.type in ['music', 'link']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.createdAt is number
                    && request.resource.data.addedBy.uid == request.auth.uid
                    && bookingOf(request.resource.data.bookingId).counsellorId == request.auth.uid;

      allow update: if false;
      allow delete: if isSignedIn() && (
        resource.data.addedBy.uid == request.auth.uid ||
        bookingOf(resource.data.bookingId).counsellorId == request.auth.uid
      );
    }

    // ---------- everything else ----------
    // Explicit default-deny for any path not matched above. Firestore already denies
    // unmatched paths by default — this exists so a newly-added collection that nobody
    // wrote a rule for fails loudly (permission-denied in the app) rather than anyone
    // assuming it's covered. When you add a real collection, copy the closest existing
    // pattern above rather than loosening this block:
    //   - "public reference data, staff-only writes" -> copy campuses/colleges
    //   - "record owned by one user, readable by staff too" -> copy bookings
    //   - "recipient-only, spam-guarded via a linked record" -> copy notifications
    //   - "fully private, single-owner data with zero staff access" -> copy journalEntries
    //   - "anonymous public content with a hidden-authorship private link" -> copy communityPosts
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
